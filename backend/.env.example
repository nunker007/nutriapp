# ── 서버 설정 ──────────────────────────────────
PORT=4000
NODE_ENV=development

# ── 식약처 API ──────────────────────────────────
# https://www.foodsafetykorea.go.kr/api/ 에서 발급
FOOD_SAFETY_API_KEY=YOUR_FOOD_SAFETY_API_KEY

# ── Spoonacular (주간 식단 생성) ────────────────
# https://spoonacular.com/food-api 에서 발급
SPOONACULAR_API_KEY=YOUR_SPOONACULAR_API_KEY

# ── JWT 인증 ────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret

# ── PostgreSQL ──────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/nutriapp

# ── AI 코칭 LLM (복구 메시지 동적 생성용) ──────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
